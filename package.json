{
  "name": "kidsvolt-bolt-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/sync-mobile-assets.mjs && vite build",
    "preview": "vite preview --host",
    "cap:sync": "pnpm build && node scripts/generate-app-icons.mjs && cap sync",
    "cap:run:ios": "node scripts/cap-run-ios.mjs",
    "cap:run:ios:device": "node scripts/cap-run-ios.mjs --target 00008120-000905D03A38C01E",
    "cap:dev:ios": "node scripts/ensure-ios-derived-data.mjs && cap run ios --live-reload --port 5173",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "icons": "node scripts/generate-app-icons.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:full": "tsc --noEmit -p tsconfig.full.json"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@fontsource/fredoka": "^5.2.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.110.8",
    "framer-motion": "^12.42.0",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.0.4",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.4.1"
}
